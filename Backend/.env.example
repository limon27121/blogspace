PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=Blog
DB_USER=root
DB_PASSWORD=

# comma separated list of frontend origins allowed to call this API from a
# browser. the frontend dev server is the only one in development
CORS_ORIGIN=http://localhost:3000

# any long random string - sign your tokens with your own, never this file's
SECRET_KEY=

# set to false once the tables are settled, to stop sequelize altering them on boot
DB_SYNC=true

# where the reset link points - the frontend owns that page, not the API
FRONTEND_URL=http://localhost:3000

# optional. With SMTP_HOST set the reset email is really sent; without it the
# link is written to the server console instead, so the flow is testable with
# no mail account. SMTP_PORT 465 means implicit TLS, 587 means STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Blog Management <no-reply@blog.local>
