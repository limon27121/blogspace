PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=Blog
DB_USER=root
DB_PASSWORD=

# comma separated list of frontend origins allowed to call this API from a
# browser. the frontend dev server is the only one in development
CORS_ORIGIN=http://localhost:3000

# any long random string - sign your tokens with your own, never this file's
SECRET_KEY=

# set to false once the tables are settled, to stop sequelize altering them on boot
DB_SYNC=true
