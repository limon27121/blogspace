        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();\r",
              "pm.test(\"status is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"response has a message string\", function () {\r",
              "    pm.expect(body.message).to.be.a(\"string\").and.to.eql(\"login successful\");\r",
