      "name": "User_Register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const lodash=require('lodash');\r",
              "const randomNumber=lodash.random(100,999);\r",
              "const email=\"limon+\"+randomNumber+\"@gmail.com\";\r",
              "pm.collectionVariables.set(\"email\", email);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();\r",
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "})\r",
              "\r",
              "pm.test(\"Response message is correct\", function () {\r",
              "    pm.expect(body.message).to.eql(\"user registered successfully\");\r",
              "})\r",
              "\r",
              "pm.test(\"Role is user\", function () {\r",
              "    pm.expect(body.data.role).to.eql(\"user\");\r",
              "});\r",
              "\r",
              "\r",
              "pm.test(\"User is active\", function () {\r",
              "    pm.expect(body.data.isActive).to.eql(true);\r",
              "});\r",
              "\r",
              "pm.collectionVariables.set(\"userId\", body.data.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
